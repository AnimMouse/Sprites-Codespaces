# sprite-codespace config — copy to ~/.config/sprite-codespace/config, and/or
# to .sprite-codespace/config in the directory you run sprite-codespace from
# (gitignored in this repo). The local file is read second, so it wins.
# Plain shell assignments; every line is optional.

# Sprites org, if you belong to more than one (default: the CLI's selected org).
#SPRITE_ORG=

# Prefix that marks a sprite as a codespace. `list` shows only these.
#SPRITE_PREFIX=cs-

# auto (default): devcontainer when the repo has a devcontainer.json, else native.
#DEFAULT_MODE=auto

# Git identity inside codespaces. Defaults to your local `git config user.*`.
#GIT_NAME="Anim Mouse"
#GIT_EMAIL=you@example.com

# An SSH key for the sprite's ssh-agent; a passphrase is fine. Only the .pub
# (which must sit next to it) is stored on the sprite. `sprite-codespace
# ssh-auth <name>` unlocks it, once per sprite reboot. Commits are signed
# with it through the agent, unless SIGNING_KEY is set.
#SSH_KEY=$HOME/.ssh/id_ed25519

# Commit signing with a passphrase-less SSH private key, copied to each
# codespace. Takes precedence over SSH_KEY for signing. Add its .pub on GitHub
# as a *Signing key*. Leave both unset to not sign.
#SIGNING_KEY=$HOME/.ssh/id_ed25519_signing

# Dotfiles, exactly as in Codespaces settings. Private repos work: the clone
# uses GH_TOKEN.
#DOTFILES_REPOSITORY=AnimMouse/dotfiles-codespaces
#DOTFILES_INSTALL_COMMAND=install.sh

#TIMEZONE=Asia/Manila

# Pin code-server; default is the newest release.
#CODE_SERVER_VERSION=4.141.0

# Image for --devcontainer on a repo with no devcontainer.json.
#DEFAULT_IMAGE=mcr.microsoft.com/devcontainers/base:ubuntu26.04

# Extra swap at /var/lib/docker/swapfile, re-enabled whenever the editor starts.
# Change it and `sprite-codespace sync` to resize; 0 removes the file.
#SWAP_SIZE=2G

# Like Codespaces' idle timeout: how long the sprite stays up after the editor
# was last used (tab closed), so builds keep running; then it sleeps. Default
# 30m, max 4h (240m); 0 turns it off, so the sprite sleeps ~30s after you
# leave. Compute is billed the whole time it is up.
#IDLE_TIMEOUT=30m
